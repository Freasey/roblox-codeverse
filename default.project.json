{
  "name": "roblox-codeverse",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Packages": {
        "$path": "Packages"
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },

    "StarterPlayer": {
      "$properties": {
        "LoadCharacterAppearance": true
      },

      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      },

      "StarterCharacterScripts": {
        "$path": "src/character"
      }
    }
  }
}
